{
  "name": "autotest-project-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "generate:api": "openapi-typescript ../context/reference/api/rest-project.yaml -o src/api-schema.d.ts && openapi-typescript ../context/reference/api/rest-task.yaml -o src/task-api-schema.d.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0",
    "typescript": "~5.9.0",
    "vue-tsc": "^3.0.0",
    "openapi-typescript": "^7.0.0",
    "@types/node": "^22.0.0"
  }
}
